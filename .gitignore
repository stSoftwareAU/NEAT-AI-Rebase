# Ignore invisible
.*
*~
!.gitignore
!.gitattributes
!.github/
!.codespellrc
!.markdownlint.json
!.markdownlint-cli2.jsonc
!.markdownlintignore

/target/
**/*.rs.bk
.DS_Store

# NEAT-AI-core lives as a sibling clone. CI checks it out inside the workspace
# as `NEAT-AI-core/` for Cargo path resolution; it must never be committed here.
/NEAT-AI-core/
/NEAT-AI-core

# Generated SBOMs (`scripts/generate-sbom.sh`). Derived from Cargo.lock and
# cargo metadata, so a committed copy is stale as soon as a dependency moves —
# `.github/workflows/sbom.yml` uploads it as a build artefact instead.
/sbom/

# Rebase runtime outputs — never commit run artefacts.
/runs/
/population-candidate.json
/rebase.json
/experiments.jsonl
